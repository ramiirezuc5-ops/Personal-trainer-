# ---------- Servidor ----------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Poné 1 si el servidor está detrás de un proxy (Render, Railway, Nginx, Vercel rewrite)
TRUST_PROXY=0

# ---------- Base de datos ----------
# MongoDB Atlas: Database > Connect > Drivers > copiar la cadena (mongodb+srv://...). Reemplazar <password>.
# Local: mongodb://127.0.0.1:27017/personal-trainer
MONGODB_URI=

# ---------- Seguridad ----------
# Generá uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# ---------- Frontend / CORS / cookies ----------
# Origen EXACTO del frontend (sin barra final). Ej: http://localhost:5173
CLIENT_URL=http://localhost:5173
# Opcional. Origen de la APP DE LOS ALUMNOS si es un sitio aparte (ej.: http://localhost:5174 en local).
# Si queda vacío, los alumnos usan la misma dirección que CLIENT_URL.
STUDENT_URL=
# lax (recomendado: frontend y API bajo el mismo sitio, ej. con rewrite /api) | strict | none
COOKIE_SAMESITE=lax
# true en producción (HTTPS). En desarrollo local sin HTTPS dejalo en false.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ---------- Correo (verificación y recuperación de contraseña) ----------
# Si SMTP_HOST queda vacío, en desarrollo los correos se imprimen en consola (no se envían).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Personal Trainer App <no-reply@tu-dominio.com>"
APP_NAME="Personal Trainer App"
